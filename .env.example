# Copy to .env and replace placeholders locally. Never commit .env.
LLM_PROVIDER="<provider-name>"
LLM_MODEL="<approved-model-name>"
LLM_API_KEY="<set-locally-do-not-commit>"
LLM_API_BASE="<optional-openai-compatible-api-base-url>"

# Absolute path outside the framework. Put one BRD and its CSV/Excel sources here.
BRD_INPUT_DIR="<absolute-path-to-external-BRD-and-source-folder>"
GOOGLE_CLOUD_PROJECT="<approved-project-id-from-the-BRD>"
GOOGLE_CLOUD_LOCATION="US"

# Needed only by the legacy provisioner; managed execution uses the BRD's datasets/bucket.
GCS_LANDING_BUCKET="<approved-bucket-from-the-BRD>"
BQ_DATASET_00="<approved-00-dataset-from-the-BRD>"
BQ_DATASET_01="<approved-01-dataset-from-the-BRD>"
BQ_DATASET_02="<approved-02-dataset-from-the-BRD>"

# Optional, explicitly approved DEV deployment exceptions. Leave commented by default.
# GCS_LANDING_BUCKET_OVERRIDE="<approved-unique-bucket>"
# GCS_BUCKET_OVERRIDE_APPROVAL="APPROVE_DEV:<project>:<BRD-bucket>:<approved-unique-bucket>"
# BRD_SERVICE_ACCOUNT_OVERRIDE="APPROVE_DEV_ADC:<project>:<BRD-service-account-email>"
